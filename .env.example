# Web
# Local: browser calls the same-origin Next proxy; this value is not bundled into the client.
NEXT_PUBLIC_APP_ENV=local
CRM_BACKEND_URL=https://dev02.eyeagle.ai/api/v1

# Deployed development: bypass the Next proxy and call the development backend directly.
# NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_API_BASE_URL=https://dev02.eyeagle.ai/api/v1

# Production: bypass the Next proxy and call the production backend directly.
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_API_BASE_URL=https://api.eyeagle.ai/api/v1

# API and worker
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eyeagle_crm
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
EYEAGLE_AUTH_BASE_URL=https://api.example.com
EYEAGLE_AUTH_LOGIN_PATH=/v1/auth/operator/login
EYEAGLE_AUTH_VERIFY_PATH=/v1/auth/operator/verify
EYEAGLE_AUTH_ME_PATH=/v1/auth/operator/me
WEBSITE_INTAKE_SECRET=replace-with-a-long-random-secret
EMAIL_PROVIDER_URL=https://email-provider.example/send
EMAIL_PROVIDER_API_KEY=replace-me
EMAIL_FROM=followups@eyeagle.in
CRM_APP_URL=http://localhost:3000
ALLOW_DEMO_AUTH=true

# Jotform is read-only and manually refreshed from the CRM.
JOTFORM_API_KEY=replace-with-read-only-key
JOTFORM_FORM_ID=replace-with-allowlisted-form-id
JOTFORM_SYNC_FROM=2026-01-01T00:00:00.000Z
JOTFORM_FIELD_MAP_JSON={"fullName":"2","phone":"4","city":"10","summary":["12","21","22","23"],"immediateSafetyConcern":"11","consideringFor":"21","safetyConcerns":"22","expressedInterest":"23","preferredContactDay":"24","preferredContactPeriod":"25"}

# Dedicated Google Workspace integration account. Store these in the deployment secret manager.
GOOGLE_CALENDAR_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=replace-me
GOOGLE_CALENDAR_REFRESH_TOKEN=replace-me
GOOGLE_CALENDAR_ID=operations@eyeagle.in
GOOGLE_CALENDAR_OPERATIONS_ATTENDEES=
