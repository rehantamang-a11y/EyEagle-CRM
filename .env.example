# Copy this file to .env.local and select the backend for this deployment.
# All browser API requests use the same-origin /sales/api/backend Next.js proxy.
# CRM_BACKEND_URL is server-only and is never included in the browser bundle.
CRM_BACKEND_URL=https://dev02.eyeagle.ai/api/v1

# Production example:
# CRM_BACKEND_URL=https://api.eyeagle.ai/api/v1
