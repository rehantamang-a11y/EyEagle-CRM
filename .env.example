# Copy this file to .env.local for local development.
#
# Local development: the browser calls the same-origin /sales/api/backend proxy.
# CRM_BACKEND_URL is server-only and is not included in the browser bundle.
NEXT_PUBLIC_APP_ENV=local
CRM_BACKEND_URL=https://dev02.eyeagle.ai/api/v1

# Deployed development: bypass the Next.js proxy and call the development backend directly.
# NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_API_BASE_URL=https://dev02.eyeagle.ai/api/v1

# Production: bypass the Next.js proxy and call the production backend directly.
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_API_BASE_URL=https://api.eyeagle.ai/api/v1
