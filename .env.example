# Web
NEXT_PUBLIC_CRM_API_URL=http://localhost:4000/api/v1

# API and worker
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eyeagle_crm
# TLS to PostgreSQL is enforced in production; set to false only for local Postgres.
DATABASE_SSL=true
DATABASE_POOL_MAX=12

# Comma-separated. Required in production; also the allowlist for the CSRF Origin check.
WEB_ORIGIN=http://localhost:3000

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SESSION_DAYS=30

# A frontend on a different host than the API needs SameSite=None, which browsers
# only accept alongside Secure. Defaults to none+secure in production, lax locally.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

EYEAGLE_AUTH_BASE_URL=https://api.example.com
EYEAGLE_AUTH_LOGIN_PATH=/v1/auth/operator/login
EYEAGLE_AUTH_VERIFY_PATH=/v1/auth/operator/verify
EYEAGLE_AUTH_ME_PATH=/v1/auth/operator/me

WEBSITE_INTAKE_SECRET=replace-with-a-long-random-secret

EMAIL_PROVIDER_URL=https://email-provider.example/send
EMAIL_PROVIDER_API_KEY=replace-me
EMAIL_FROM=followups@eyeagle.in
CRM_APP_URL=http://localhost:3000

# Demo auth accepts ANY password for any @eyeagle.in address and grants admin to
# anything starting with "admin". The API refuses to boot with this enabled when
# NODE_ENV=production.
ALLOW_DEMO_AUTH=true

# Rate limits (requests per window)
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_INTAKE_MAX=120

# Worker
WORKER_TICK_MS=5000
WORKER_BATCH_SIZE=25
WORKER_MAINTENANCE_TICKS=12
WORKER_STUCK_MINUTES=10

# Jotform intake (optional). Only needed to enable POST /intake/jotform/sync,
# the admin-triggered "pull new submissions" route. Leave blank to disable.
JOTFORM_API_KEY=
JOTFORM_FORM_ID=
